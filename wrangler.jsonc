{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sex-and-the-city",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  // process.env for the Anthropic and TypeSafe SDKs (they read their keys from it).
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "npm run build" },
  "assets": { "directory": "dist", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sex-and-the-city", "database_id": "b336d2e7-2486-4c71-95b7-3aa887de893f" }],
  // Model routes cost money; the leaderboard is cheap.
  "ratelimits": [
    { "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "BOARD_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "routes": [
    { "pattern": "sexandthecity.fun", "custom_domain": true },
    { "pattern": "www.sexandthecity.fun", "custom_domain": true }
  ],
  // Run next to the Anthropic API: from some edge locations its calls came back 403 "Request not allowed".
  "placement": { "mode": "targeted", "hostname": "api.anthropic.com" },
  "observability": { "enabled": true }
}
